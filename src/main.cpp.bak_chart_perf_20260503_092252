static QFile logFile;
static QTextStream logStream;

void initLog() {
    logFile.setFileName("magistrala3.log");
    if (logFile.open(QIODevice::WriteOnly | QIODevice::Append | QIODevice::Text))
        logStream.setDevice(&logFile);
}

void debugLog(const QString &msg) {
    QString ts = QDateTime::currentDateTime().toString("hh:mm:ss.zzz");
    if (logFile.isOpen()) {
        logStream << "[" << ts << "] " << msg << Qt::endl;
        logStream.flush();
    }
    qDebug().noquote() << "[" << ts << "] " << msg;
}

int main(int argc, char *argv[])
{
    QApplication app(argc, argv);
    initLog();
    debugLog("Aplikacja startuje");

    QMainWindow window;
    window.setWindowTitle("MagistralaCAN3");
    window.resize(1200, 600);

    auto *central = new QWidget;
    auto *mainLayout = new QVBoxLayout(central);
    mainLayout->setContentsMargins(0, 0, 0, 0);
    mainLayout->setSpacing(0);

    // ========== TAB WIDGET ==========
    auto *tabWidget = new QTabWidget;
    mainLayout->addWidget(tabWidget);

    // ---------- Zakładka Sniffer ----------
    auto *snifferTab = new QWidget;
    auto *snifferLayout = new QVBoxLayout(snifferTab);
    snifferLayout->setContentsMargins(5, 5, 5, 0);
    snifferLayout->setSpacing(4);

    auto *controlLayout = new QHBoxLayout;
    controlLayout->setSpacing(4);

    auto makeButton = [](const QString &text) {
        auto *btn = new QPushButton(text);
        btn->setMaximumHeight(28);
        btn->setSizePolicy(QSizePolicy::Preferred, QSizePolicy::Fixed);
        return btn;
    };

    auto *addChannelBtn = makeButton("Dodaj kanał");
    auto *removeChannelBtn = makeButton("Usuń kanał");
    auto *clearBtn = makeButton("Wyczyść");
    auto *saveBtn = makeButton("Zapisz candump");

    auto *overwriteCheck = new QCheckBox("Nadpisywanie");
    overwriteCheck->setMaximumHeight(28);
    auto *highlightCheck = new QCheckBox("Podświetlaj");
    highlightCheck->setChecked(true);
    highlightCheck->setMaximumHeight(28);

    auto *modeCombo = new QComboBox;
    modeCombo->addItems({"CAN 2.0", "CAN FD", "J1939"});
    modeCombo->setMaximumHeight(28);

    auto *tuningWidget = new QWidget;
    auto *tuningLayout = new QHBoxLayout(tuningWidget);
    tuningLayout->setContentsMargins(0,0,0,0);
    auto *windowSpin = new QDoubleSpinBox;
    windowSpin->setRange(0.5, 10.0); windowSpin->setValue(2.0); windowSpin->setSingleStep(0.5);
    windowSpin->setMaximumHeight(28); windowSpin->setPrefix("Okno: ");
    auto *thresholdSpin = new QDoubleSpinBox;
    thresholdSpin->setRange(0.0, 1.0); thresholdSpin->setValue(0.1); thresholdSpin->setSingleStep(0.05);
    thresholdSpin->setMaximumHeight(28); thresholdSpin->setPrefix("Próg: ");
    tuningLayout->addWidget(windowSpin);
    tuningLayout->addWidget(thresholdSpin);

    // Uczenie
    auto *learnModeCombo = new QComboBox;
    learnModeCombo->addItems({"Zdarzenie (hamulec)", "Wartość (temperatura)"});
    learnModeCombo->setMaximumHeight(28);
    auto *learnStack = new QStackedWidget; learnStack->setMaximumHeight(32);
    auto *eventPanel = new QWidget; auto *eventLayout = new QHBoxLayout(eventPanel);
    eventLayout->setContentsMargins(0,0,0,0);
    auto *eventCheck = new QCheckBox("Hamulec"); eventCheck->setMaximumHeight(28);
    auto *iterSpin = new QSpinBox; iterSpin->setRange(1, 100); iterSpin->setValue(1); iterSpin->setMaximumHeight(28);
    auto *iterBtn = makeButton("Iteruj");
    eventLayout->addWidget(eventCheck); eventLayout->addWidget(new QLabel("Powtórzeń:"));
    eventLayout->addWidget(iterSpin); eventLayout->addWidget(iterBtn);
    learnStack->addWidget(eventPanel);
    auto *valPanel = new QWidget; auto *valLayout = new QHBoxLayout(valPanel);
    valLayout->setContentsMargins(0,0,0,0);
    auto *valueEdit = new QLineEdit; valueEdit->setPlaceholderText("np. 85.5"); valueEdit->setMaximumHeight(28);
    auto *addSampleBtn = makeButton("Dodaj próbkę");
    auto *computeCorrBtn = makeButton("Oblicz korelacje");
    valLayout->addWidget(valueEdit); valLayout->addWidget(addSampleBtn); valLayout->addWidget(computeCorrBtn);
    learnStack->addWidget(valPanel);

    // Kompaktowe menu narzędzi
    auto *toolCombo = new QComboBox;
    toolCombo->addItems({"Wczytaj Lua", "Nagraj", "Stop nagr.", "Odtwórz", "Stop odtwarz."});
    toolCombo->setMaximumHeight(28);
    auto *toolExecBtn = makeButton("Wykonaj");

    controlLayout->addWidget(addChannelBtn); controlLayout->addWidget(removeChannelBtn);
    controlLayout->addWidget(clearBtn); controlLayout->addWidget(saveBtn);
    controlLayout->addWidget(overwriteCheck); controlLayout->addWidget(highlightCheck);
    controlLayout->addWidget(new QLabel("Tryb:")); controlLayout->addWidget(modeCombo);
    controlLayout->addWidget(learnModeCombo); controlLayout->addWidget(learnStack);
    controlLayout->addWidget(tuningWidget);
    controlLayout->addWidget(toolCombo);
    controlLayout->addWidget(toolExecBtn);
    snifferLayout->addLayout(controlLayout);

    // Główny widok sniffera: splitter
    auto *splitter = new QSplitter(Qt::Horizontal);
    auto *model = new CanFrameModel;
    auto *tableView = new QTableView;
    tableView->setModel(model);
    tableView->horizontalHeader()->setStretchLastSection(true);
    splitter->addWidget(tableView);

    auto *detailView = new CanFrameDetailView;
    splitter->addWidget(detailView);

    auto *sidePanel = new QWidget;
    auto *sideLayout = new QVBoxLayout(sidePanel);
    auto *sideCombo = new QComboBox;
    sideCombo->addItems({"Kandydaci asocjacji", "Korelacje bajtów", "Wykresy przebiegów"});
    sideCombo->setMaximumHeight(28);
    auto *sideStack = new QStackedWidget;
    auto *candidateListView = new CandidateListView;
    auto *byteCorrView = new ByteCorrelationView;
    sideStack->addWidget(candidateListView);
    sideStack->addWidget(byteCorrView);
    auto *timeSeries = new TimeSeriesWidget;
    sideStack->addWidget(timeSeries);
    sideLayout->addWidget(sideCombo);
    sideLayout->addWidget(sideStack);
    sidePanel->setLayout(sideLayout);
    splitter->addWidget(sidePanel);

    splitter->setStretchFactor(0, 3);
    splitter->setStretchFactor(1, 1);
    splitter->setStretchFactor(2, 1);
    snifferLayout->addWidget(splitter);

    tabWidget->addTab(snifferTab, "Sniffer");
    window.setCentralWidget(central);

    // ========== ZAKŁADKA GATEWAY ==========
    auto *gwTab = new QWidget;
    auto *gwLayout = new QVBoxLayout(gwTab);
    auto *gwRow1 = new QHBoxLayout;
    auto *gwACombo = new QComboBox;
    auto *gwBCombo = new QComboBox;
    gwACombo->setMaximumHeight(28); gwBCombo->setMaximumHeight(28);
    gwRow1->addWidget(new QLabel("Kanał A:"));
    gwRow1->addWidget(gwACombo);
    gwRow1->addWidget(new QLabel("Kanał B:"));
    gwRow1->addWidget(gwBCombo);
    gwLayout->addLayout(gwRow1);

    auto *gwRow2 = new QHBoxLayout;
    auto *gwStartBtn = new QPushButton("Start Gateway");
    auto *gwStopBtn = new QPushButton("Stop Gateway"); gwStopBtn->setEnabled(false);
    auto *gwBidirCheck = new QCheckBox("Dwukierunkowy"); gwBidirCheck->setChecked(true);
    auto *gwLuaCheck = new QCheckBox("Modyfikuj przez Lua");
    gwRow2->addWidget(gwStartBtn);
    gwRow2->addWidget(gwStopBtn);
    gwRow2->addWidget(gwBidirCheck);
    gwRow2->addWidget(gwLuaCheck);
    gwLayout->addLayout(gwRow2);

    auto *ruleEdit = new QPlainTextEdit;
    ruleEdit->setPlaceholderText("# Reguły:\nif id == 0x123 -> setByte(0, 0xAA)\nif dlc > 4 -> drop()");
    ruleEdit->setMaximumHeight(100);
    gwLayout->addWidget(ruleEdit);
    auto *applyRulesBtn = new QPushButton("Zastosuj reguły");
    gwLayout->addWidget(applyRulesBtn);
    gwTab->setLayout(gwLayout);
    tabWidget->addTab(gwTab, "Gateway");

    // Obiekty globalne
    CandumpExporter exporter;
    QMap<QString, CanWorker*> workers;
    CanGateway gateway;
    RuleEngine ruleEngine;
    SessionRecorder recorder;
    PlaybackEngine playbackEngine;
    AssocLearner learner(2.0);
    ValueAssocLearner valueLearner(2.0);
    LuaEngine luaEngine;
    luaEngine.setModel(model);

    auto refreshGatewayChannels = [&]() {
        QStringList names = workers.keys();
        gwACombo->clear();
        gwBCombo->clear();
        gwACombo->addItems(names);
        gwBCombo->addItems(names);
    };

    // ========== POŁĄCZENIA ==========
    QObject::connect(overwriteCheck, &QCheckBox::toggled, model, &CanFrameModel::setOverwriteMode);
    QObject::connect(highlightCheck, &QCheckBox::toggled, model, &CanFrameModel::setHighlightEnabled);

    QObject::connect(tableView->selectionModel(), &QItemSelectionModel::currentRowChanged,
        [model, detailView, timeSeries](const QModelIndex &idx, const QModelIndex &) {
            if (!idx.isValid()) {
                detailView->clearFrame();
                timeSeries->clearGraphs();
            } else {
                CanFrame f = model->frameAt(idx.row());
                detailView->showFrame(f);
                timeSeries->setActiveId(f.id);
                // dodajemy ostatnią ramkę jako punkt startowy na wykresie
                double ts = f.timestamp.tv_sec + f.timestamp.tv_usec / 1e6;
                timeSeries->addDataPoint(f.id, f.data, f.dlc, ts);
            }
        });
    QObject::connect(model, &CanFrameModel::frameUpdated, [timeSeries](int row, const CanFrame &f, const QVector<int> &c) {
        double ts = f.timestamp.tv_sec + f.timestamp.tv_usec / 1e6;
        timeSeries->addDataPoint(f.id, f.data, f.dlc, ts);
    });
    QObject::connect(model, &CanFrameModel::frameUpdated,
        [tableView, model, detailView](int row, const CanFrame &f, QVector<int> changed) {
            if (tableView->selectionModel()->isSelected(model->index(row,0)))
                detailView->showFrame(f);
            detailView->highlightChanges(changed);
        });

    // Dodawanie kanału
    QObject::connect(addChannelBtn, &QPushButton::clicked, [&]() {
        // Okno konfiguracji kanału z checkboxem „Z pliku”
        QDialog dialog(&window);
        dialog.setWindowTitle("Nowy kanał");
        auto *dlgLayout = new QVBoxLayout(&dialog);
        auto *dlgEdit = new QLineEdit("vcan0");
        auto *dlgFileCheck = new QCheckBox("Z pliku (.can)");
        auto *dlgFileEdit = new QLineEdit;
        dlgFileEdit->setPlaceholderText("Ścieżka do pliku .can");
        dlgFileEdit->setEnabled(false);
        auto *dlgBrowseBtn = new QPushButton("Przeglądaj...");
        auto *dlgBtnBox = new QDialogButtonBox(QDialogButtonBox::Ok | QDialogButtonBox::Cancel);

        dlgLayout->addWidget(new QLabel("Nazwa interfejsu / pliku:"));
        dlgLayout->addWidget(dlgEdit);
        dlgLayout->addWidget(dlgFileCheck);
        dlgLayout->addWidget(dlgFileEdit);
        dlgLayout->addWidget(dlgBrowseBtn);
        dlgLayout->addWidget(dlgBtnBox);

        QObject::connect(dlgFileCheck, &QCheckBox::toggled, [&](bool checked) {
            dlgFileEdit->setEnabled(checked);
            dlgBrowseBtn->setEnabled(checked);
            dlgEdit->setEnabled(!checked);
        });
        QObject::connect(dlgBrowseBtn, &QPushButton::clicked, [&]() {
            QString path = QFileDialog::getOpenFileName(&dialog, "Wybierz plik CAN", "", "CAN Rec (*.can)");
            if (!path.isEmpty()) dlgFileEdit->setText(path);
        });
        QObject::connect(dlgBtnBox, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
        QObject::connect(dlgBtnBox, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);

        if (dialog.exec() == QDialog::Accepted) {
            if (dlgFileCheck->isChecked()) {
                // Odtwarzanie z pliku
                QString path = dlgFileEdit->text();
                if (path.isEmpty()) {
                    debugLog("Nie wybrano pliku.");
                    return;
                }
                if (!playbackEngine.loadFile(path)) return;
                debugLog(QString("Odtwarzanie offline: %1").arg(path));

                // Tworzymy wirtualny worker do odtwarzania (dowolny, byle coś przekazać)
                CanWorker *vw = new CanWorker;
                vw->setMode(CanWorker::CAN20);
                // Zapamiętujemy go w mapie (do celów Gateway itp.)
                QString vname = QFileInfo(path).fileName();
                workers[vname] = vw;
                    QObject::connect(model, &CanFrameModel::newFramesReady, [timeSeries](const QVector<CanFrame> &frames) {
        for (const auto &f : frames) {
            double ts = f.timestamp.tv_sec + f.timestamp.tv_usec / 1e6;
            timeSeries->addDataPoint(f.id, f.data, f.dlc, ts);
        }
    });

    refreshGatewayChannels();

                playbackEngine.start(vw);
                // Możemy dodać do modelu tablicy jakąś informację
                model->clear(); // opcjonalnie
            } else {
                // Fizyczny interfejs (stara logika)
                QString ifname = dlgEdit->text().trimmed();
                if (ifname.isEmpty()) return;
                debugLog(QString("Dodawanie kanału: %1").arg(ifname));
                QThread *thread = new QThread;
                CanWorker *worker = new CanWorker;
                worker->setInterface(ifname);
                QString modeStr = modeCombo->currentText();
                CanWorker::Mode mode = CanWorker::CAN20;
                if (modeStr == "CAN FD") mode = CanWorker::CANFD;
                else if (modeStr == "J1939") mode = CanWorker::J1939;
                worker->setMode(mode);
                worker->moveToThread(thread);
                ThrottledFrameModel *throttler = new ThrottledFrameModel(model);
                QObject::connect(thread, &QThread::started, worker, &CanWorker::process);
                QObject::connect(worker, &CanWorker::framesReady, throttler, &ThrottledFrameModel::appendFrames);
                QObject::connect(thread, &QThread::finished, worker, &QObject::deleteLater);
                QObject::connect(thread, &QThread::finished, thread, &QObject::deleteLater);
                thread->start();
                workers[ifname] = worker;
                    QObject::connect(model, &CanFrameModel::newFramesReady, [timeSeries](const QVector<CanFrame> &frames) {
        for (const auto &f : frames) {
            double ts = f.timestamp.tv_sec + f.timestamp.tv_usec / 1e6;
            timeSeries->addDataPoint(f.id, f.data, f.dlc, ts);
        }
    });

    refreshGatewayChannels();
            }
        }
    });

    QObject::connect(clearBtn, &QPushButton::clicked, model, &CanFrameModel::clear);

    // Eksport
    QObject::connect(saveBtn, &QPushButton::clicked, [&]() {
        QString path = QFileDialog::getSaveFileName(nullptr, "Zapisz ramki", "candump.log", "Candump (*.log *.txt)");
        if (!path.isEmpty()) {
            QList<CanFrame> frames;
            for (int i = 0; i < model->rowCount(); ++i) frames.append(model->frameAt(i));
            exporter.exportToFile(frames, path, "vcan0");
        }
    });

    // Uczenie
    QObject::connect(eventCheck, &QCheckBox::toggled, &learner, &AssocLearner::setEventActive);
    QObject::connect(iterBtn, &QPushButton::clicked, [&]() {
        int n = iterSpin->value(); bool active = eventCheck->isChecked();
        learner.setEventActive(active); learner.performIterations(n, active); learner.setEventActive(false);
        auto candidates = learner.getFilteredCandidates(20, thresholdSpin->value());
        candidateListView->setCandidates(candidates);
        QSet<uint32_t> ids; for (const auto &c : candidates) ids.insert(c.id);
        model->setHighlightedCandidates(ids);
        debugLog(QString("Iteracja: %1 próbek, %2 kandydatów").arg(n).arg(candidates.size()));
    });
    QObject::connect(windowSpin, QOverload<double>::of(&QDoubleSpinBox::valueChanged), [&learner](double val) { learner.setWindowSec(val); });

    QObject::connect(addSampleBtn, &QPushButton::clicked, [&]() {
        bool ok; double val = valueEdit->text().toDouble(&ok);
        if (ok) { valueLearner.addValueSample(val); debugLog(QString("Próbka: %1").arg(val)); }
    });
    QObject::connect(computeCorrBtn, &QPushButton::clicked, [&]() {
        byteCorrView->setCorrelations(valueLearner.computeCorrelations(30));
    });

    // Lua
    QObject::connect(&luaEngine, &LuaEngine::scriptOutput, [](const QString &s) { debugLog("Lua: " + s); });
    QObject::connect(&luaEngine, &LuaEngine::scriptError, [](const QString &e) { debugLog("Lua ERROR: " + e); });
    QObject::connect(&luaEngine, &LuaEngine::sendFrameRequested, [&](uint32_t id, const QByteArray &data) {
        debugLog(QString("Lua: wysyłam 0x%1").arg(id, 3, 16, QChar('0')));
    });

    QObject::connect(model, &CanFrameModel::frameUpdated, [timeSeries](int row, const CanFrame &f, const QVector<int> &c) {
        double ts = f.timestamp.tv_sec + f.timestamp.tv_usec / 1e6;
        timeSeries->addDataPoint(f.id, f.data, f.dlc, ts);
    });
    QObject::connect(model, &CanFrameModel::frameUpdated, [&](int row, const CanFrame &f, const QVector<int> &c) {
        Q_UNUSED(row); Q_UNUSED(c);
        learner.processFrame(f); valueLearner.processFrame(f); luaEngine.handleFrame(f);
        recorder.addFrame(f);
    });

    // Side / Learn combo
    QObject::connect(sideCombo, QOverload<int>::of(&QComboBox::currentIndexChanged), sideStack, &QStackedWidget::setCurrentIndex);
    QObject::connect(learnModeCombo, QOverload<int>::of(&QComboBox::currentIndexChanged), learnStack, &QStackedWidget::setCurrentIndex);

    // Gateway
    QObject::connect(gwStartBtn, &QPushButton::clicked, [&]() {
        QString aName = gwACombo->currentText(), bName = gwBCombo->currentText();
        if (aName.isEmpty() || bName.isEmpty() || aName == bName) { debugLog("Gateway: wybierz dwa różne kanały"); return; }
        CanWorker *wA = workers.value(aName), *wB = workers.value(bName);
        if (!wA || !wB) return;
        gateway.setModelA(model); gateway.setModelB(model);
        gateway.setWorkerA(wA); gateway.setWorkerB(wB);
        gateway.setBidirectional(gwBidirCheck->isChecked());
        gateway.setLuaModifyEnabled(gwLuaCheck->isChecked());
        gateway.setRuleEngine(&ruleEngine);
        gateway.start();
        gwStartBtn->setEnabled(false); gwStopBtn->setEnabled(true);
        debugLog("Gateway: start " + aName + " <-> " + bName);
    });
    QObject::connect(gwStopBtn, &QPushButton::clicked, [&]() {
        gateway.stop();
        gwStartBtn->setEnabled(true); gwStopBtn->setEnabled(false);
        debugLog("Gateway: zatrzymany");
    });
    QObject::connect(applyRulesBtn, &QPushButton::clicked, [&]() {
        QStringList rules = ruleEdit->toPlainText().split('\n');
        ruleEngine.loadRules(rules);
        debugLog("Reguły załadowane: " + QString::number(rules.size()));
    });

    // Menu narzędzi (Lua, Nagrywanie, Odtwarzanie)
    QObject::connect(toolExecBtn, &QPushButton::clicked, [&]() {
        int idx = toolCombo->currentIndex();
        switch (idx) {
        case 0: { // Wczytaj Lua
            QString path = QFileDialog::getOpenFileName(nullptr, "Wybierz skrypt Lua", "", "Lua (*.lua)");
            if (!path.isEmpty()) luaEngine.loadScript(path);
            break;
        }
        case 1: { // Nagraj
            QString path = QFileDialog::getSaveFileName(nullptr, "Zapisz sesję", "session.can", "CAN Rec (*.can)");
            if (!path.isEmpty()) recorder.startRecording(path);
            break;
        }
        case 2: recorder.stopRecording(); break;      // Stop nagr.
        case 3: { // Odtwórz
            QString path = QFileDialog::getOpenFileName(nullptr, "Wybierz sesję", "", "CAN Rec (*.can)");
            if (!path.isEmpty() && !workers.isEmpty()) recorder.startPlayback(workers.first());
            break;
        }
        case 4: recorder.stopPlayback(); break;        // Stop odtwarz.
        }
    });

    // Skróty klawiszowe
    auto addShortcut = [&](const QKeySequence &key, QPushButton *btn) {
        QShortcut *sc = new QShortcut(key, &window);
        QObject::connect(sc, &QShortcut::activated, btn, &QPushButton::click);
    };
    auto toggleShortcut = [&](const QKeySequence &key, QCheckBox *cb) {
        QShortcut *sc = new QShortcut(key, &window);
        QObject::connect(sc, &QShortcut::activated, cb, &QCheckBox::toggle);
    };
    addShortcut(QKeySequence("Ctrl+N"), addChannelBtn); addShortcut(QKeySequence("Ctrl+W"), removeChannelBtn);
    addShortcut(QKeySequence("Ctrl+K"), clearBtn); addShortcut(QKeySequence("Ctrl+S"), saveBtn);
    toggleShortcut(QKeySequence("Ctrl+O"), overwriteCheck); toggleShortcut(QKeySequence("Ctrl+H"), highlightCheck);
    toggleShortcut(QKeySequence("Space"), eventCheck); addShortcut(QKeySequence("Ctrl+I"), iterBtn);
    addShortcut(QKeySequence("Ctrl+D"), addSampleBtn); addShortcut(QKeySequence("Ctrl+B"), computeCorrBtn);

    // Skróty dla menu narzędziowego
    auto toolShortcut = [&](const QKeySequence &key, int comboIdx) {
        QShortcut *sc = new QShortcut(key, &window);
        QObject::connect(sc, &QShortcut::activated, [&, comboIdx]() {
            toolCombo->setCurrentIndex(comboIdx);
            toolExecBtn->click();
        });
    };
    toolShortcut(QKeySequence("Ctrl+L"), 0);
    toolShortcut(QKeySequence("Ctrl+R"), 1);
    toolShortcut(QKeySequence("Ctrl+Shift+R"), 2);
    toolShortcut(QKeySequence("Ctrl+P"), 3);
    toolShortcut(QKeySequence("Ctrl+Shift+P"), 4);

        QObject::connect(model, &CanFrameModel::newFramesReady, [timeSeries](const QVector<CanFrame> &frames) {
        for (const auto &f : frames) {
            double ts = f.timestamp.tv_sec + f.timestamp.tv_usec / 1e6;
            timeSeries->addDataPoint(f.id, f.data, f.dlc, ts);
        }
    });

    refreshGatewayChannels();

    window.show();
    int ret = app.exec();
    debugLog("Aplikacja zamknięta");
    if (logFile.isOpen()) logFile.close();
    return ret;
}
