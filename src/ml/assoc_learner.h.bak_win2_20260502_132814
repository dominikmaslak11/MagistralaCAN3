#ifndef ASSOC_LEARNER_H
#define ASSOC_LEARNER_H

#include <QObject>
#include <QMap>
#include <QSet>
#include <QVector>
#include "can/can_interface.h"

struct Candidate {
    uint32_t id;
    double score;
    int eventCount;
    int totalCount;
};

class AssocLearner : public QObject {
    Q_OBJECT
public:
    explicit AssocLearner(double windowSec = 2.0, QObject *parent = nullptr);

    void processFrame(const CanFrame &frame);
    void setEventActive(bool active);
    void reset();
    const QVector<TimedFrame>& currentWindow() const { return window_; }

    QVector<Candidate> getCandidates(int topN = 20) const;
    // Zwraca ID, które są obecnie kandydatami (do podświetlania)
    QSet<uint32_t> candidateIds() const;

signals:
    void candidatesUpdated();

private:
    void flushWindow();

    struct TimedFrame {
        CanFrame frame;
        double ts; // seconds
    };

    double windowSec_;
    bool eventActive_ = false;
    QVector<TimedFrame> window_;
    QMap<uint32_t, int> eventCounts_;   // ID -> liczba okien event
    QMap<uint32_t, int> totalCounts_;   // ID -> liczba wszystkich okien
    int totalEventWindows_ = 0;
    int totalBgWindows_ = 0;
    QSet<uint32_t> currentCandidates_;
};

#endif
